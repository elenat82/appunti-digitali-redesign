RewriteEngine On

Options -Indexes

DirectorySlash Off
RewriteOptions AllowNoSlash

<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  <FilesMatch "\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# Redirect legacy Drupal 8.
RewriteRule ^varie/xmlhttprequest-api/?$ https://www.appunti-digitali.it/appunti/varie/xmlhttprequest-proprieta [R=301,L]
RewriteRule ^css/display-flex/?$ https://www.appunti-digitali.it/appunti/css/flexbox [R=301,L]
RewriteRule ^javascript/metodi-i-numeri/?$ https://www.appunti-digitali.it/appunti/javascript/i-numeri [R=301,L]
RewriteRule ^varie/formati-delle-immagini/?$ https://www.appunti-digitali.it/appunti/varie/formati-delle-immagini-dei-video-e-dei-suoni [R=301,L]
RewriteRule ^varie/le-reti-parte-ii/?$ https://www.appunti-digitali.it/appunti/varie/le-reti-i-protocolli [R=301,L]
RewriteRule ^varie/architettura-degli-elaboratori/?$ https://www.appunti-digitali.it/appunti/varie/architettura-degli-elaboratori-hardware [R=301,L]
RewriteRule ^varie/i-sistemi-operativi/?$ https://www.appunti-digitali.it/appunti/varie/il-sistema-operativo [R=301,L]
RewriteRule ^varie/progettazione-del-software/?$ https://www.appunti-digitali.it/appunti/varie/progettazione-database [R=301,L]
RewriteRule ^varie/salesforce/?$ https://www.appunti-digitali.it/appunti/varie/salesforce-glossario [R=301,L]
RewriteRule ^varie/riga-di-comando-shell/?$ https://www.appunti-digitali.it/appunti/varie/riga-di-comando-e-shell [R=301,L]
RewriteRule ^varie/composer/?$ https://www.appunti-digitali.it/appunti/varie/composer-e-drush [R=301,L]

RewriteRule ^php/concetti-di-base/?$ https://www.appunti-digitali.it/appunti/php/introduzione [R=301,L]
RewriteRule ^php/oop-parte-i/?$ https://www.appunti-digitali.it/appunti/php/oop-parte-i-concetti-base [R=301,L]
RewriteRule ^php/oop-parte-iii/?$ https://www.appunti-digitali.it/appunti/php/oop-parte-iii-magic-methods [R=301,L]
RewriteRule ^php/oop-parte-ii/?$ https://www.appunti-digitali.it/appunti/php/oop-parte-ii-encapsulation-abstraction-inheritance-polymorphism [R=301,L]
RewriteRule ^php/oop-parte-iv-confronto-tra-oggetti/?$ https://www.appunti-digitali.it/appunti/php/oop-parte-iv-le-eccezioni [R=301,L]
RewriteRule ^php/oop-parte-vi-accesso-al-database/?$ https://www.appunti-digitali.it/appunti/php/oop-parte-vi-il-database [R=301,L]

RewriteRule ^drupal/introduzione/?$ https://www.appunti-digitali.it/appunti/drupal/theming-parte-i [R=301,L]
RewriteRule ^drupal/theming/?$ https://www.appunti-digitali.it/appunti/drupal/theming-parte-i [R=301,L]
RewriteRule ^drupal/theming-creazione-di-tema-e-regioni/?$ https://www.appunti-digitali.it/appunti/drupal/theming-creazione-del-tema-e-regioni [R=301,L]

# Canonicalizza le route prerenderizzate senza trailing slash.
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_FILENAME}/index.html -f
RewriteCond %{REQUEST_URI} !^/$
RewriteRule ^(.+)/$ https://www.appunti-digitali.it/$1 [R=301,L]

# Serve index.html delle route prerenderizzate mantenendo l'URL senza slash.
RewriteCond %{REQUEST_URI} !/$
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_FILENAME}/index.html -f
RewriteRule ^(.+)$ $1/index.html [L]
